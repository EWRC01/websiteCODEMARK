# Mailjet credentials used by app/api/contact/route.ts.
# Important: Mailjet must be active/unblocked and CONTACT_FROM_EMAIL must be a verified sender.
# If Mailjet returns 401 with "Your account has been temporarily blocked", contact Mailjet support.
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key

# Verified sender configured in Mailjet
CONTACT_FROM_EMAIL=no-reply@codemark.es
CONTACT_FROM_NAME=CodeMark Website

# Destination inbox for new contact form submissions. Use commas for multiple administrators.
CONTACT_TO_EMAIL=info@codemark.es
CONTACT_TO_NAME=CodeMark

# Absolute public URL used in email templates for the SVG logo
NEXT_PUBLIC_SITE_URL=https://codemark.es
